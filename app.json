{
  "expo": {
    "name": "Diyabet Mobil",
    "slug": "diyabet-mobil",
    "version": "1.0.0",
    "plugins": [
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "minSdkVersion": 24,
            "packagingOptions": {
              "pickFirsts": ["**/libc++_shared.so", "**/libfbjni.so"]
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3e91236a-9d6e-4c79-ab8a-89fbcdae90af"
      }
    },
    "android": {
      "package": "com.busecam17.diyabetmobil",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "usesCleartextTraffic": true
    }
  }
}